package info.learn.sorting;

public class MergeSort {

	public static void main(String[] args) {
		int arr[] = { 12, 11, 13, 5, 6, 7 };
		printArray(arr);
		sort(arr, 0, arr.length - 1);
	}

	private static void sort(int[] arr, int startIndex, int endIndex) {

		if (startIndex < endIndex) {

			int mid = (startIndex + endIndex) / 2;

			sort(arr, startIndex, mid);
			sort(arr, mid + 1, endIndex);

			merge(arr, startIndex, mid, endIndex);
		}

	}

	private static void merge(int[] arr, int startIndex, int mid, int endIndex) {
		
		//Size of two sub arrays
		int n1 = mid - startIndex + 1;
        int n2 = endIndex - mid;
        
        /* Create temp arrays */
        int L[] = new int [n1];
        int R[] = new int [n2];
        
        /*Copy data to temp arrays*/
        for (int i=0; i<n1; ++i)
            L[i] = arr[startIndex + i];
        for (int j=0; j<n2; ++j)
            R[j] = arr[mid + 1+ j];
        
        
		
	}

	private static void printArray(int arr[]) {
		int n = arr.length;
		for (int i = 0; i < n; ++i)
			System.out.print(arr[i] + " ");
		System.out.println();
	}

}
