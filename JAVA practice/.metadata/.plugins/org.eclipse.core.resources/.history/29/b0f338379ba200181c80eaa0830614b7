package info.practice.cci.tree;

import java.util.Iterator;
import java.util.LinkedList;
import java.util.Map;
import java.util.Map.Entry;
import java.util.Queue;
import java.util.Set;
import java.util.TreeMap;

/**
 *                    20
                    /    \
                  8       22
                /   \        \
              5      3       25
                    /   \      
                  10    14

 * @author indiahiring *
 */
public class BottomViewOfBinaryTree {

	public static void main(String[] args) {
		
		Node root = new Node(20);
		root.left = new Node(8);
		root.right = new Node(22);
		root.left.left = new Node(5);
		root.left.right = new Node(3);
		root.left.right.left = new Node(10);
		root.left.right.right  = new Node(14);
		root.right.right  = new Node(25);
		System.out.println("Printing bottom view");
		BinaryTree tree = new BinaryTree(root);
		tree.printBottomView();
		
		/**
		 *            20
                    /    \
                  8       22
                /   \     /   \
              5      3 4     25
                     /    \      
                 10       14

		 */
		Node root1 = new Node(20);
		root1.left = new Node(8);
		root1.right = new Node(22);
		root1.left.left = new Node(5);
		root1.left.right = new Node(3);
		root1.right.left = new Node(4);
		root1.left.right.left  = new Node(10);
		root1.left.right.right  = new Node(14);
		root1.right.right  = new Node(25);
		
		System.out.println("Printing second tree");
		tree = new BinaryTree(root1);
		tree.printBottomView();
	}

}

class BinaryTree {
	
	Node root;
	
	public BinaryTree(){
		
	}
	
	public BinaryTree(Node node){
		root = node;
	}
	
	public void printBottomView(){		
		
		if(root == null)
			return;
		
		int nodeDistance = 0;
		
		Map<Integer,Integer> map = new TreeMap<Integer,Integer>();
		
		Queue<Node> queue = new LinkedList<Node>();
		
		root.nodeDistance = nodeDistance;
		queue.add(root);
		
		while(!queue.isEmpty()){
			
			
			Node temp = queue.remove();
			nodeDistance = temp.nodeDistance;
			
			map.put(nodeDistance, temp.data);
			
			if(temp.left!=null){
				temp.left.nodeDistance = nodeDistance - 1;
				queue.add(temp.left);
			}
			
			if(temp.right!=null){
				temp.right.nodeDistance = nodeDistance + 1;
				queue.add(temp.right);
			}
			
		}
		
		Set<Entry<Integer,Integer>> set = map.entrySet();
		Iterator<Entry<Integer,Integer>> itr = set.iterator();
		
		while(itr.hasNext()){
			Map.Entry<Integer,Integer> val = itr.next();
			System.out.println(val.getValue()+" ");
		}
		
	}
	
}
