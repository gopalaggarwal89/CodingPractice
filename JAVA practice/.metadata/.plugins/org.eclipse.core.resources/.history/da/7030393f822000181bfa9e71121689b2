package info.practice.cci.linkedlist;

import java.util.LinkedList;

public class Node {
	
	private int data;
	private Node next;	
	
	private Node head;
	
	public Node() {
		
	}
	
	public Node(int data) {
		this.data = data;
	}
	
	public void addNode(int data) {
		Node node = new Node(data);
		if(head == null) {
			head = node;
		}else {
			Node temp = head;
			while(temp.next != null) {
				temp = temp.next;
			}
			temp.next = node;
		}
	}
	
	@Override
	public String toString() {
		return "Node [data=" + data + ", node=" + next + "]";
	}

	public int getData() {
		return data;
	}
	public void setData(int data) {
		this.data = data;
	}
	public Node getNode() {
		return next;
	}
	public void setNode(Node node) {
		this.next = node;
	}
	
	public Node getHead() {
		return this.head;
	}
}
