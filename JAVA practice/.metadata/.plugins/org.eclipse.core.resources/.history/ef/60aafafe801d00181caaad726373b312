package info.learn.multithreading;

import java.util.ArrayList;
import java.util.List;

public class ProducerConsumerClient {

	public static void main(String[] args) {

		PCHelper helper = new PCHelper();

		Thread t1 = new Thread(new Runnable() {

			@Override
			public void run() {
				try {
					helper.produce();
				} catch (InterruptedException e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
				}

			}
		});

		Thread t2 = new Thread(new Runnable() {

			@Override
			public void run() {
				try {
					helper.consume();
				} catch (InterruptedException e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
				}
			}

		});

		t1.start();
		t2.start();

		try {
			t1.join();
			t2.join();
		} catch (InterruptedException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	}

}

class PCHelper {

	boolean flag = true;
	int capacity = 2;

	List<Integer> lst = new ArrayList<Integer>();

	public void consume() throws InterruptedException {

		while (!flag) {
			synchronized (this) {
				while (lst.size() == 0)
					wait();
				int i = lst.get(0);
				System.out.println(lst.remove(i));
			}

			flag = true;
			notify();
		}
	}

	public void produce() throws InterruptedException {
		int value = 0;
		while (flag) {
			synchronized (this) {
				while (lst.size() == capacity)
					wait();
				int i = value++;
				System.out.println("Producer " + i);
				lst.add(i);
			}

			flag = false;
			notify();
		}
	}

}
