package info.learn.algo;

public class SumOfTwoValues {
	
	/**
	 * Input array
	 * Output must return sum of two
	 * @param args
	 */
	public static void main(String[] args) {
		
		int[] array = {1,3,5,8,12,15,18};
		int length = array.length;
		String temp = null;
		for(int i=0;i<length;i++) {
			int nextVal = i + 1;
			int sum = 0;
			if(nextVal < length) {
				sum = array[i] + array[nextVal];
				if(sum == 20) {
					temp = String.valueOf(array[i]) + " : " + String.valueOf(array[nextVal]);
				}
			}			
		}
		
		System.out.println(temp);
		
	}
	

}
