package info.learn.general;

public class ReverseString {
	
	public static void main(String[] args) {
		
		String str = "Gopal";
		
		
		
	}
	
	private String reversed(int startIndex, int endIndex, char[] str) {
		
		if(startIndex == endIndex || startIndex > endIndex) {
			return str.toString();
		}
		
		return str.toString();
	}

}
