package info.learn.oops;

import java.util.Date;

public final class ImmutableClass {

	final String name;
	final Date date;

	public ImmutableClass() {
		
	}
	
	public ImmutableClass(String name,Date date) {
		this.name = name;
		this.date = date;
	}

	public static ImmutableClass getImmutableClass(String name,Date date) {
		return new ImmutableClass(name, date);
	}
	
	public String getName() {
		return name;
	}
	
	public Date getDate() {
		return new Date(date.getTime());
	}
}
